{
  "name": "calyx-flow-editor-wrapper",
  "version": "0.1.0",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "description": "Flow editor wrapper for calyx-cli - provides a React-based flow editor that can be launched from the CLI",
  "main": "./src/server.ts",
  "module": "./src/server.ts",
  "types": "./src/server.ts",
  "exports": {
    ".": {
      "bun": "./src/server.ts",
      "import": "./src/server.ts",
      "types": "./src/server.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "bin": {
    "calyx-flow-editor-wrapper": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "calyx-flow-editor": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "react",
    "flow-editor",
    "calyx",
    "wrapper",
    "bun"
  ]
}
