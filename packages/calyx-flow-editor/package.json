{
  "name": "calyx-flow-editor",
  "version": "1.0.0",
  "description": "A minimal React library example",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run dev-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@unocss/postcss": "^66.6.6",
    "@unocss/preset-wind3": "^66.6.6",
    "typescript": "^5.0.0",
    "unocss": "^66.6.6"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.1",
    "calyx-flow": "workspace:*"
  }
}
