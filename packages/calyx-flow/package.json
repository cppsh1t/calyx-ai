{
  "name": "calyx-flow",
  "version": "0.1.0",
  "module": "./index.ts",
  "types": "./dist/src/core/flow.d.ts",
  "type": "module",
  "private": true,
  "files": [
    "dist/**/*",
    "index.ts",
    "src/**/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/core/flow.d.ts",
      "import": "./index.ts"
    },
    "./types": {
      "types": "./dist/src/types/index.d.ts",
      "import": "./src/types/index.ts"
    },
    "./core": {
      "types": "./dist/src/core/flow.d.ts",
      "import": "./src/core/index.ts"
    },
    "./services": {
      "types": "./dist/src/services/index.d.ts",
      "import": "./src/services/index.ts"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "test": "bun test || true",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsc-alias": "^1.8.16"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.72",
    "@ai-sdk/anthropic": "^3.0.53",
    "@ai-sdk/azure": "^3.0.40",
    "@ai-sdk/cerebras": "^2.0.37",
    "@ai-sdk/cohere": "^3.0.23",
    "@ai-sdk/deepinfra": "^2.0.37",
    "@ai-sdk/deepseek": "^2.0.21",
    "@ai-sdk/gateway": "^3.0.61",
    "@ai-sdk/google": "^3.0.36",
    "@ai-sdk/google-vertex": "^4.0.71",
    "@ai-sdk/groq": "^3.0.27",
    "@ai-sdk/mistral": "^3.0.22",
    "@ai-sdk/openai": "^3.0.39",
    "@ai-sdk/openai-compatible": "^2.0.33",
    "@ai-sdk/perplexity": "^3.0.21",
    "@ai-sdk/togetherai": "^2.0.37",
    "@ai-sdk/vercel": "^2.0.35",
    "@ai-sdk/xai": "^3.0.64",
    "@gitlab/gitlab-ai-provider": "^4.1.0",
    "@jerome-benoit/sap-ai-provider-v2": "^4.4.18",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "ai": "^6.0.105",
    "ai-gateway-provider": "^3.1.1",
    "radash": "^12.1.1",
    "venice-ai-sdk-provider": "^1.1.18",
    "zod": "^4.3.6"
  }
}
