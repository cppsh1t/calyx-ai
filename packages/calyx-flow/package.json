{
  "name": "calyx-flow",
  "version": "0.1.0",
  "license": "AGPL-3.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs",
      "default": "./dist/types.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs",
      "default": "./dist/core.js"
    },
    "./services": {
      "types": "./dist/services.d.ts",
      "import": "./dist/services.js",
      "require": "./dist/services.cjs",
      "default": "./dist/services.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "bun test || true",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/uuid": "^11.0.0",
    "tsup": "^8.5.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.72",
    "@ai-sdk/anthropic": "^3.0.53",
    "@ai-sdk/azure": "^3.0.40",
    "@ai-sdk/cerebras": "^2.0.37",
    "@ai-sdk/cohere": "^3.0.23",
    "@ai-sdk/deepinfra": "^2.0.37",
    "@ai-sdk/deepseek": "^2.0.21",
    "@ai-sdk/gateway": "^3.0.61",
    "@ai-sdk/google": "^3.0.36",
    "@ai-sdk/google-vertex": "^4.0.71",
    "@ai-sdk/groq": "^3.0.27",
    "@ai-sdk/mistral": "^3.0.22",
    "@ai-sdk/openai": "^3.0.39",
    "@ai-sdk/openai-compatible": "^2.0.33",
    "@ai-sdk/perplexity": "^3.0.21",
    "@ai-sdk/togetherai": "^2.0.37",
    "@ai-sdk/vercel": "^2.0.35",
    "@ai-sdk/xai": "^3.0.64",
    "@gitlab/gitlab-ai-provider": "^4.1.0",
    "@jerome-benoit/sap-ai-provider-v2": "^4.4.18",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "ai": "^6.0.105",
    "ai-gateway-provider": "^3.1.1",
    "radash": "^12.1.1",
    "uuid": "^13.0.0",
    "venice-ai-sdk-provider": "^1.1.18",
    "zod": "^4.3.6"
  }
}
