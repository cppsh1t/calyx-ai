{
  "name": "calyx-app",
  "version": "0.0.0",
  "license": "AGPL-3.0",
  "description": "Bun-built core library for Bun applications — application bootstrap, config, auth, providers, logging, and CLI utilities",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "bun": ">=1.3.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "bun": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "bun": "./dist/config/index.js",
      "default": "./dist/config/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "bun": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "bun": "./dist/providers/index.js",
      "default": "./dist/providers/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "bun": "./dist/logging/index.js",
      "default": "./dist/logging/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.app.json",
    "verify": "bun run build && bun run check-types",
    "dev": "bun --watch src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~5.9.3"
  }
}
